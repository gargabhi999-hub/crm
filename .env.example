# =========================================================================
#            NEXUS / SPIKE CRM ENVIRONMENT CONFIGURATION EXAMPLE
# =========================================================================

# PostgreSQL Database URL (Render PostgreSQL or local PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT Signing Secrets (Use strong random >=32-byte secrets in production)
JWT_SECRET="replace-with-strong-64-char-random-hex-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_DAYS="7"

# Optional symmetric key for encrypting stored admin SMTP passwords (AES-256-GCM)
SMTP_ENCRYPTION_KEY="replace-with-strong-32-byte-secret"

# Argon2id Tuning Parameters (OWASP recommended baselines)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Monolithic Express & Socket.io Server Port
PORT=4000
NODE_ENV=development

# Frontend URL for CORS, Cookies, and Password Reset Links
FRONTEND_URL="http://localhost:5173"

# Optional Default SuperAdmin Bootstrap Credentials (used only on initial seed if no superadmin exists)
DEFAULT_SUPERADMIN_EMAIL="superadmin@spike.crm"
DEFAULT_SUPERADMIN_PASSWORD=""

# Groq Llama Vision OCR API (Optional)
GROQ_API_KEY=""

# Brevo SMTP Email Relay (Required for password reset & confirmation receipts)
BREVO_USER=""
BREVO_PASS=""
BREVO_SENDER=""

# Redis Cache & Rate Limiter URL (Optional - falls back to in-memory)
REDIS_URL=""

# Cloudflare Turnstile Protection (https://dash.cloudflare.com/?to=/:account/turnstile)
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
TURNSTILE_ALLOWED_HOSTNAMES=""
TURNSTILE_REQUIRED="true"
